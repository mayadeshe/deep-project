    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-27T14:30:42.651855Z\",\n",
    "     \"start_time\": \"2026-02-27T12:44:50.047437Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Cell 5 — Run inpainting & display side-by-side (Vanilla | Improved | Novel)\\n\",\n",
    "    \"from novel_inpaint import ddpm_inpaint_improved as ddpm_inpaint_novel\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"assert all(caption for _, _, stem, caption in pairs), \\\\\\n\",\n",
    "    \"    'Some images have no prompt — run Cell 4 first.'\\n\",\n",
    "    \"\\n\",\n",
    "    \"for img_path, mask_path, stem, prompt in tqdm(pairs, desc='Inpainting'):\\n\",\n",
    "    \"    image, mask = preprocess_inputs(img_path, mask_path)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    van = ddpm_inpaint(pipe, image, mask, prompt, STEPS, GUIDANCE_SCALE, SEED)\\n\",\n",
    "    \"    imp = ddpm_inpaint_improved(pipe, image, mask, prompt, STEPS, GUIDANCE_SCALE, SEED, RESAMPLE_STEPS)\\n\",\n",
    "    \"    nov = ddpm_inpaint_novel(pipe, image, mask, prompt, STEPS, GUIDANCE_SCALE, SEED, RESAMPLE_STEPS, BLEND_STRENGTH)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    masked_vis = apply_mask_for_display(image, mask)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, axes = plt.subplots(1, 5, figsize=(25, 5))\\n\",\n",
    "    \"    axes[0].imshow(image);      axes[0].set_title('Original')\\n\",\n",
    "    \"    axes[1].imshow(masked_vis); axes[1].set_title('Masked')\\n\",\n",
    "    \"    axes[2].imshow(van);        axes[2].set_title('Vanilla')\\n\",\n",
    "    \"    axes[3].imshow(imp);        axes[3].set_title('Improved')\\n\",\n",
    "    \"    axes[4].imshow(nov);        axes[4].set_title('Novel')\\n\",\n",
    "    \"    for ax in axes:\\n\",\n",
    "    \"        ax.axis('off')\\n\",\n",
    "    \"    plt.suptitle(f'{stem}  |  prompt: \\\"{prompt}\\\"', fontsize=11, y=1.01)\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    plt.show()\"\n",
    "   ],\n",
