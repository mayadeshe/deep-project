    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"  0000: using existing prompt \\\"A large building with a clock at the top of it .\\\"\\n\",\n",
    "      \"  Scissors: using existing prompt \\\"scissors\\\"\\n\",\n",
    "      \"  Work-Kitchen: using existing prompt \\\"kitchen with tables and chairs\\\"\\n\",\n",
    "      \"  backgamon: using existing prompt \\\"backgammon board\\\"\\n\",\n",
    "      \"  backyard: using existing prompt \\\"backyard with synthetic grass\\\"\\n\",\n",
    "      \"  disney: using existing prompt \\\"disney castle\\\"\\n\",\n",
    "      \"  fence: using existing prompt \\\"white stripy fence\\\"\\n\",\n",
    "      \"  ferrari: using existing prompt \\\"red ferrari\\\"\\n\",\n",
    "      \"  flower: using existing prompt \\\"pink flower\\\"\\n\",\n",
    "      \"  pan: using existing prompt \\\"a non-stick pan\\\"\\n\",\n",
