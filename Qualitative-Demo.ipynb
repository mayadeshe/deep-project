    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"\\n\",\n",
    "      \"Found 11 image/mask pair(s):\\n\",\n",
    "      \"  0000: \\\"A large building with a clock at the top of it .\\\"\\n\",\n",
    "      \"  Scissors: \\\"scissors\\\"\\n\",\n",
    "      \"  Work-Kitchen: \\\"kitchen with tables and chairs\\\"\\n\",\n",
    "      \"  backgamon: \\\"backgammon board\\\"\\n\",\n",
    "      \"  backyard: \\\"backyard with synthetic grass\\\"\\n\",\n",
    "      \"  disney: \\\"disney castle\\\"\\n\",\n",
    "      \"  fence: \\\"white stripy fence\\\"\\n\",\n",
    "      \"  ferrari: \\\"red ferrari\\\"\\n\",\n",
    "      \"  flower: \\\"pink flower\\\"\\n\",\n",
    "      \"  pan: \\\"a non-stick pan\\\"\\n\",\n",
    "      \"  pot: \\\"a large bright pot\\\"\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-27T12:44:50.017977Z\",\n",
    "     \"start_time\": \"2026-02-27T12:44:44.092863Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Cell 3 — Load model\\n\",\n",
    "    \"sys.path.insert(0, os.path.abspath('.'))\\n\",\n",
    "    \"from vanilla_inpaint import ddpm_inpaint\\n\",\n",
    "    \"from improved_inpaint import ddpm_inpaint_improved\\n\",\n",
    "    \"\\n\",\n",
    "    \"device = 'mps' if torch.backends.mps.is_available() else 'cpu'\\n\",\n",
    "    \"print(f'Using device: {device}')\\n\",\n",
    "    \"pipe = load_sd_pipeline(device)\\n\",\n",
    "    \"pipe.set_progress_bar_config(disable=True)\\n\",\n",
    "    \"print('Model loaded.')\"\n",
    "   ],\n",
    "   \"id\": \"cd3e45176412db91\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Using device: mps\\n\"\n",
    "     ]\n",
    "    },\n",
    "    {\n",
    "     \"name\": \"stderr\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Loading pipeline components...: 100%|██████████| 6/6 [00:00<00:00, 19.79it/s]\\n\"\n",
    "     ]\n",
    "    },\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Model loaded.\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 3\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-02-27T12:44:50.042311Z\",\n",
    "     \"start_time\": \"2026-02-27T12:44:50.025239Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": \"# Cell 4 — Interactive prompt collection (only for pairs with empty captions)\\nimport json\\n\\nfor img_path, mask_path, stem, caption in pairs:\\n    if caption:\\n        print(f'  {stem}: using existing prompt \\\"{caption}\\\"')\\n        continue\\n\\n    image_preview, mask_preview = preprocess_inputs(img_path, mask_path)\\n    masked_vis = apply_mask_for_display(image_preview, mask_preview)\\n\\n    fig, axes = plt.subplots(1, 2, figsize=(10, 5))\\n    axes[0].imshow(image_preview); axes[0].set_title('Original')\\n    axes[1].imshow(masked_vis);    axes[1].set_title('Masked (region to inpaint)')\\n    for ax in axes:\\n        ax.axis('off')\\n    plt.suptitle(stem, fontsize=12)\\n    plt.tight_layout()\\n    plt.show()\\n\\n    prompt = input(f'Prompt for \\\"{stem}\\\" (leave blank for unconditional): ').strip()\\n\\n    # Persist to json so the prompt survives kernel restarts\\n    json_path = os.path.join(MY_IMAGES_DIR, stem + '.json')\\n    with open(json_path, 'w') as jf:\\n        json.dump({'caption': prompt}, jf)\\n    print(f'  -> saved \\\"{prompt}\\\" to {stem}.json\\\\n')\\n\\n# Reload pairs with up-to-date captions\\npairs = [\\n    (img_path, mask_path, stem,\\n     json.load(open(os.path.join(MY_IMAGES_DIR, stem + '.json'))).get('caption', ''))\\n    for img_path, mask_path, stem, _ in pairs\\n]\",\n",
    "   \"id\": \"1afb7e9d82af733b\",\n",
